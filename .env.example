# quillAgent backend — configuration template.
#
# Copy to `.env` and fill in. Values are never committed; this file lists the
# names only. It exists because .gitignore already had a `!.env.example`
# negation for a file that had never been created, so a fresh clone had no way
# to discover that QUILL_API_KEY is mandatory — the process exits 1 without it.

# --- Required -------------------------------------------------------------

# Shared secret between the bridges/executors (x-quill-api-key header) and this
# backend. Unset, /api/approvals and its resume tokens are exposed unauthenticated,
# so the process refuses to start. Generate: openssl rand -hex 32
QUILL_API_KEY=""

# --- Server ---------------------------------------------------------------

PORT="3001"
# Comma-separated origins allowed to call the API (loopkind's URL).
QUILL_ALLOWED_ORIGINS="http://localhost:3000"

# --- Rate limiting --------------------------------------------------------

QUILL_RATE_LIMIT_API_PER_MIN="120"
QUILL_RATE_LIMIT_AUTH_PER_MIN="10"
# Set to 1 only in local development.
QUILL_RATE_LIMIT_DISABLED="0"

# --- loopkind ------------------------------------------------------------

# Web-push (VAPID) keypair. Generate: npx web-push generate-vapid-keys
LOOPKIND_VAPID_PUBLIC_KEY=""
LOOPKIND_VAPID_PRIVATE_KEY=""
LOOPKIND_VAPID_SUBJECT="mailto:you@example.com"

# Whether new loopkind accounts may self-register. Keep 0 in production.
LOOPKIND_ALLOW_SIGNUPS="0"
